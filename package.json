{
	"name": "terminal.svelte",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ashwin-mahadevan/terminal.svelte.git"
	},
	"author": {
		"name": "Ashwin Mahadevan",
		"email": "mahadevan@ashwinm.com",
		"url": "https://ashwinm.com/"
	},
	"description": "Streaming terminal emulator component written in Svelte 5",
	"homepage": "https://github.com/ashwin-mahadevan/terminal.svelte",
	"bugs": {
		"url": "https://github.com/ashwin-mahadevan/terminal.svelte/issues"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"prepack": "pnpm exec svelte-kit sync && pnpm exec svelte-package && pnpm exec publint"
	},
	"files": [
		"dist",
		"!dist/**/*.unit.js",
		"!dist/**/*.unit.d.ts",
		"!dist/**/*.dom.js",
		"!dist/**/*.dom.d.ts",
		"!dist/**/*.bench.js",
		"!dist/**/*.bench.d.ts"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^4.1.12",
		"@xterm/headless": "^6.0.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-svelte": "^3.23.1",
		"node-pty": "^1.2.0-beta.18",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.3.25",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.2.1"
	},
	"keywords": [
		"terminal",
		"emulator",
		"streaming",
		"svelte"
	]
}
